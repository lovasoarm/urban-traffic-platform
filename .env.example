# Images explicites et figees (versions verifiees le 14/11/2026)
MONGO_IMAGE=mongo:7.0.48
REDIS_IMAGE=redis:7.4.12-alpine
CASSANDRA_IMAGE=cassandra:4.1.12
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
GRAFANA_IMAGE=grafana/grafana-oss:13.3.1

# Ports publies sur l'hote
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# Stockages
MONGO_DATABASE=urban_traffic
MONGO_RETENTION_DAYS=7
REDIS_TTL_SECONDS=600
CASSANDRA_DATACENTER=datacenter1

# Grafana local seulement : changer le mot de passe avant tout usage non local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Regles de trafic (ratio vitesse observee / vitesse limite)
TRAFFIC_MAX_BATCH_SIZE=500
TRAFFIC_SMOOTHING_FACTOR=0.35
TRAFFIC_MAX_READING_AGE=10m
TRAFFIC_MAX_FUTURE_SKEW=1m
CONGESTION_FREE_RATIO=0.70
CONGESTION_DENSE_RATIO=0.40
CONGESTION_CONGESTED_RATIO=0.15

# Historique
HISTORY_MAX_IMPORT_BATCH_SIZE=5000
HISTORY_MAX_RANGE_DAYS=31
HISTORY_COLLECTOR_FIXED_RATE_MS=300000
HISTORY_COLLECTOR_INITIAL_DELAY_MS=20000

# Prevision
PREDICTION_SEGMENTS=segment-01,segment-02,segment-03,segment-04,segment-05,segment-06,segment-07,segment-08,segment-09,segment-10
PREDICTION_LOOKBACK_DAYS=14
PREDICTION_MINIMUM_SAMPLES=100
PREDICTION_TRAINING_FIXED_RATE_MS=3600000
PREDICTION_RETRY_FIXED_DELAY_MS=30000
PREDICTION_HISTORY_PAGE_SIZE=5000

# Simulation automatique
SIMULATOR_SEED_DAYS=14
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_SEGMENT_COUNT=10
SIMULATOR_MEASUREMENTS_PER_SEGMENT=3
SIMULATOR_CENTER_LAT=-18.8792
SIMULATOR_CENTER_LON=47.5079
SIMULATOR_RANDOM_SEED=20261114
SIMULATOR_MANAGEMENT_PORT=9084
